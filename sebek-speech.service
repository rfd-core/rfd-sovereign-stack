[Unit]
Description=SEBEK Speech Agent (Vosk ASR)
After=network.target

[Service]
Type=simple
User=sebek
Group=sebek
WorkingDirectory=/opt/rfd-sovereign-stack
ExecStart=/opt/sebek-speech-venv/bin/python3 /opt/rfd-sovereign-stack/sebek_speech_agent.py --model /opt/vosk-model-small-en-us-0.15 --persist-dir /var/lib/sebek/speech
Restart=on-failure
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
